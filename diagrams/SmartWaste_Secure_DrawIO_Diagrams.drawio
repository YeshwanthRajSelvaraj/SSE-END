  <mxGeometry x="800" y="125" width="330" height="55" as="geometry"/>
</mxCell><mxCell id="s_assets" value="A-02 Device credentials&lt;br&gt;A-03 Telemetry&lt;br&gt;A-04 Bin location&lt;br&gt;A-05 Collection routes&lt;br&gt;A-08 Audit/security logs&lt;br&gt;A-11 Application secrets&lt;br&gt;A-12 Database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#17365D;fontColor=#17365D;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
  <mxGeometry x="60" y="205" width="300" height="250" as="geometry"/>
</mxCell><mxCell id="s_threats" value="Sensor spoofing&lt;br&gt;Location manipulation&lt;br&gt;Unauthorized route modification&lt;br&gt;Availability / DoS&lt;br&gt;Device authentication failure&lt;br&gt;API security abuse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#17365D;fontColor=#17365D;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
  <mxGeometry x="430" y="205" width="300" height="250" as="geometry"/>
</mxCell><mxCell id="s_controls" value="TLS&lt;br&gt;Device authentication&lt;br&gt;JWT + RBAC / object-level auth&lt;br&gt;Input/schema/range validation&lt;br&gt;Rate limiting&lt;br&gt;Audit logging&lt;br&gt;Least privilege + secret management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#17365D;fontColor=#17365D;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
  <mxGeometry x="800" y="205" width="330" height="250" as="geometry"/>
</mxCell><mxCell id="se1" value="protect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s_assets" target="s_threat">
  <mxGeometry relative="1" as="geometry"></mxGeometry>
</mxCell><mxCell id="se2" value="mitigate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s_threat" target="s_control">
  <mxGeometry relative="1" as="geometry"></mxGeometry>
</mxCell><mxCell id="s_trace" value="Critical trace baseline: SR-06 Route Authorization → Modify Route use case → P3 Route Management → unauthorized modification threat → IDOR / missing object-level authorization → implementation with RBAC → negative authorization test → deployment RBAC/audit control." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
  <mxGeometry x="60" y="505" width="1070" height="95" as="geometry"/>
</mxCell><mxCell id="s_cons" value="Consistency rule: requirements, DFD entities/processes/stores, ER entities, architecture components and later Jira stories/tests must use the same system vocabulary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
