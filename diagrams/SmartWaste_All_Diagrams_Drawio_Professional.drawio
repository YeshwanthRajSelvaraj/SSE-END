  <diagram id="08_Trust_Boundaries" name="08 Trust Boundaries">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tb_t" value="SmartWaste Secure — Trust Boundaries &amp; Security Zones" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="950" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tb_s" value="Yeshwanth Raj S. | CH.SC.U4CYS23052 | 24CYS401" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="900" height="25" as="geometry" />
        </mxCell>
        <mxCell id="z1" value="&lt;b&gt;TB-1 — IOT / UNTRUSTED DEVICE NETWORK&lt;/b&gt;&lt;br&gt;&lt;br&gt;Smart bins • sensor firmware • MQTT client • device credentials&lt;br&gt;&lt;br&gt;&lt;b&gt;Threats:&lt;/b&gt; device spoofing • telemetry tampering • replay • flooding" style="rounded=0;dashed=1;strokeWidth=2;strokeColor=#4b5563;fillColor=none;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontSize=14;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="125" width="1080" height="165" as="geometry" />
        </mxCell>
        <mxCell id="z2" value="&lt;b&gt;TB-2 — APPLICATION / API NETWORK&lt;/b&gt;&lt;br&gt;&lt;br&gt;API Gateway • Flask services • Web UI • authentication / RBAC&lt;br&gt;&lt;br&gt;&lt;b&gt;Threats:&lt;/b&gt; credential abuse • broken authorization • API abuse" style="rounded=0;dashed=1;strokeWidth=2;strokeColor=#4b5563;fillColor=none;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontSize=14;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="320" width="1080" height="165" as="geometry" />
        </mxCell>
        <mxCell id="z3" value="&lt;b&gt;TB-3 — PROTECTED DATA LAYER&lt;/b&gt;&lt;br&gt;&lt;br&gt;PostgreSQL • routes • telemetry • audit/security records • secrets&lt;br&gt;&lt;br&gt;&lt;b&gt;Threats:&lt;/b&gt; unauthorized access • integrity loss • secret exposure" style="rounded=0;dashed=1;strokeWidth=2;strokeColor=#4b5563;fillColor=none;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontSize=14;fontStyle=1;html=1;" vertex="1" parent="1">
